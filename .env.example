# ═══════════════════════════════════════════════════════════════════════════
#  FRONTEND — variables de entorno
#
#  Solo las variables con prefijo VITE_ llegan al navegador, y todo lo que
#  llega al navegador es PÚBLICO. Nunca pongas secretos aquí.
#
#  Se leen EN EL MOMENTO DEL BUILD, no en runtime. Cambiar una exige volver a
#  construir y desplegar.
# ═══════════════════════════════════════════════════════════════════════════

# URL base de la API, con /api/v1 incluido.
#
# DESARROLLO: déjala vacía. vite.config.ts hace proxy de /api hacia
# http://localhost:8080, así trabajas sin CORS ni líos de cookies.
#
# PRODUCCIÓN: también vacía. La función functions/api/[[ruta]].js de
# Cloudflare reenvía /api/* a Cloud Run (variable BACKEND_URL en Pages), así la
# cookie de sesión es del mismo dominio y el iPhone no la bloquea.
# Apuntar directo a *.run.app hace que la app instalada pierda la sesión.
#


# Ojo: sin el /api/v1 al final, todas las llamadas darán 404.
VITE_API_URL=


# ID de cliente OAuth de Google (el mismo que GOOGLE_CLIENT_ID del backend).
# Es público por diseño. Vacío = la app no muestra el botón de Google.
# En Google Cloud Console agrega como "Origen autorizado de JavaScript" tanto
# http://localhost:5173 como el dominio de producción.
VITE_GOOGLE_CLIENT_ID=
